{
  "manifest_version": 3,
  "name": "Card Price Check",
  "version": "0.2.0",
  "description": "Highlights underpriced card listings on eBay versus Japan-located sellers and Cardmarket, and periodically scans Carousell HK and Facebook Marketplace for new PSA-graded Japanese card deals. Runs entirely in your browser.",
  "permissions": ["storage", "offscreen", "alarms", "notifications"],
  "host_permissions": [
    "https://www.ebay.com/*",
    "https://www.ebay.co.uk/*",
    "https://www.ebay.de/*",
    "https://www.ebay.fr/*",
    "https://www.ebay.com.au/*",
    "https://www.ebay.ca/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Card Price Check settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "watches.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.ebay.com/sch/*",
        "https://www.ebay.com/itm/*",
        "https://www.ebay.co.uk/sch/*",
        "https://www.ebay.co.uk/itm/*",
        "https://www.ebay.de/sch/*",
        "https://www.ebay.de/itm/*",
        "https://www.ebay.fr/sch/*",
        "https://www.ebay.fr/itm/*",
        "https://www.ebay.com.au/sch/*",
        "https://www.ebay.com.au/itm/*",
        "https://www.ebay.ca/sch/*",
        "https://www.ebay.ca/itm/*"
      ],
      "js": ["money.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.cardmarket.com/*"],
      "js": ["money.js", "cm-scraper.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.carousell.com.hk/*"],
      "js": ["money.js", "carousell-scraper.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/marketplace/*",
        "https://www.facebook.com/login*",
        "https://www.facebook.com/checkpoint*"
      ],
      "js": ["money.js", "fbm-scraper.js"],
      "run_at": "document_idle"
    }
  ]
}
